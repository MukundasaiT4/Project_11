@model Project_11.Models.ServiceRequest
@{
    ViewBag.Title = "Raise Service Request";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Submit New Campus Service Request</h4>
        </div>
        <div class="card-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    @Html.LabelFor(m => m.StudentEnrollment, new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.StudentEnrollment, new { @class = "form-control", placeholder = "e.g., 92400120465" })
                    @Html.ValidationMessageFor(m => m.StudentEnrollment, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.StudentName, new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.StudentName, new { @class = "form-control", placeholder = "Enter Full Name" })
                    @Html.ValidationMessageFor(m => m.StudentName, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Category, new { @class = "form-label fw-bold" })
                    @Html.DropDownListFor(m => m.Category, new SelectList(new[] { "IT Support", "Library", "Maintenance", "Hostel" }), "-- Select Category --", new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.Category, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Description, new { @class = "form-label fw-bold" })
                    @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 3, placeholder = "Describe your campus service issue..." })
                    @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
                </div>

                <button type="submit" class="btn btn-success">Submit Request</button>
                <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>
            }
        </div>
    </div>
</div>